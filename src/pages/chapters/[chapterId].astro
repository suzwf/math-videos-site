---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VideoCard from '../../components/VideoCard.astro';
import { getAllChapters, getChapterById } from '../../utils/chapters';
import { getVideosByChapter } from '../../utils/videos';

export function getStaticPaths() {
  return getAllChapters().map((chapter) => ({ params: { chapterId: chapter.id } }));
}

const { chapterId } = Astro.params;
const chapter = getChapterById(chapterId ?? '');

if (!chapter) {
  return Astro.redirect('/');
}

const videos = getVideosByChapter(chapter.id);
---
<BaseLayout title={`${chapter.name}视频｜高中数学短视频`} description={chapter.description}>
  <Header />
  <main>
    <section class="chapter-hero section">
      <div class="container">
        <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: chapter.name }]} />
        <span class="pill">{chapter.stageName}</span>
        <h1>{chapter.name}</h1>
        <p>{chapter.description}</p>
        <div class="keywords">
          {chapter.keywords.map((keyword) => <span>{keyword}</span>)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-title">
          <h2>本章视频</h2>
          <p class="muted">共 {videos.length} 个视频</p>
        </div>
        <div class="grid grid-3">
          {videos.map((video) => <VideoCard video={video} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .chapter-hero {
    background: linear-gradient(135deg, #eff6ff, #ffffff);
  }

  h1 {
    margin: 14px 0 12px;
    font-size: clamp(36px, 7vw, 58px);
    line-height: 1.1;
  }

  .chapter-hero p {
    max-width: 760px;
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 18px;
  }

  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .keywords span {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: white;
    padding: 5px 12px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 20px;
  }

  .section-title h2 {
    margin: 0;
    font-size: 30px;
  }
</style>
