---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SearchBox from '../components/SearchBox.astro';
import ChapterCard from '../components/ChapterCard.astro';
import VideoCard from '../components/VideoCard.astro';
import { getAllChapters, getStages } from '../utils/chapters';
import { getPublishedVideos, getVideosByChapter } from '../utils/videos';

const stages = getStages();
const chapters = getAllChapters();
const latestVideos = getPublishedVideos().slice(0, 6);
---
<BaseLayout title="高中数学短视频知识库｜同步预习与基础复习">
  <Header />
  <main>
    <section class="hero">
      <div class="container hero-inner">
        <span class="pill">高中数学 · 短视频学习</span>
        <h1>按章节快速找到清晰的高中数学讲解视频</h1>
        <p>覆盖集合、函数、三角函数、平面向量、数列、立体几何等同步内容，适合课前预习、课后复习和基础巩固。</p>
        <SearchBox />
      </div>
    </section>

    <section id="chapters" class="section">
      <div class="container">
        <div class="section-title">
          <h2>章节目录</h2>
          <p class="muted">先按高一、高二常见章节整理，后续可继续扩展知识点和题型视频。</p>
        </div>
        {stages.map((stage) => (
          <div class="stage-block">
            <h3>{stage.name}</h3>
            <div class="grid grid-3">
              {chapters.filter((chapter) => chapter.stageId === stage.id).map((chapter) => (
                <ChapterCard chapter={chapter} videoCount={getVideosByChapter(chapter.id).length} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section latest">
      <div class="container">
        <div class="section-title">
          <h2>最新视频</h2>
          <a href="/search">查看全部</a>
        </div>
        <div class="grid grid-3">
          {latestVideos.map((video) => <VideoCard video={video} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    padding: 72px 0 56px;
    background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 58%, #ffffff 100%);
  }

  .hero-inner {
    max-width: 820px;
  }

  h1 {
    margin: 18px 0 16px;
    font-size: clamp(36px, 7vw, 64px);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .hero p {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 19px;
  }

  .section-title {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 22px;
  }

  .section-title h2 {
    margin: 0;
    font-size: 30px;
  }

  .section-title p {
    margin: 8px 0 0;
  }

  .section-title a {
    color: var(--brand-dark);
    font-weight: 800;
  }

  .stage-block + .stage-block {
    margin-top: 34px;
  }

  .stage-block > h3 {
    margin: 0 0 16px;
    font-size: 22px;
  }

  .latest {
    background: white;
  }

  @media (max-width: 680px) {
    .hero {
      padding: 44px 0 34px;
    }

    .section-title {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
