---
import type { Video } from '../utils/videos';

export interface Props {
  video: Video;
}

const { video } = Astro.props;
---
<div class="player card">
  <video controls preload="metadata" poster={video.cover_url}>
    <source src={video.video_url} type="video/mp4" />
    当前浏览器不支持视频播放。
  </video>
</div>

<style>
  .player {
    overflow: hidden;
    background: #0f172a;
  }

  video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
  }
</style>
